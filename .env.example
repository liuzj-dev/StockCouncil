# ============================================================
#  StockCouncil 环境变量样例
#  用法：复制本文件为 .env，然后只填你想启用的端口即可。
#        （不填任何 Key 也能启动，平台会走 Mock 演示端口）
# ============================================================

# ---------- 模型端口（填哪个启用哪个，可只填一个）----------

# Google Gemini —— https://aistudio.google.com/app/apikey
# 原生协议，内置 Google Search 联网检索，适合宏观 / 行业情报类角色
GEMINI_API_KEY=

# xAI Grok —— https://console.x.ai/
XAI_API_KEY=

# OpenAI (GPT) —— https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ChatGPT（预留插槽）—— 需同时填 BASE_URL 与 API Key 才会启用
# BASE_URL 可指向官方端点、Azure OpenAI、企业网关或任意 OpenAI 兼容代理
CHATGPT_API_KEY=
CHATGPT_BASE_URL=

# DeepSeek —— https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 通义千问 Qwen —— https://bailian.console.aliyun.com/
QWEN_API_KEY=

# 自定义端点（OpenAI 兼容）—— vLLM / Ollama / 企业网关 / 代理
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# ---------- 可选：覆盖各端点的默认 Base URL（一般不用改）----------
# GEMINI_BASE_URL=
# XAI_BASE_URL=
# OPENAI_BASE_URL=
# DEEPSEEK_BASE_URL=
# QWEN_BASE_URL=

# ---------- 服务参数 ----------

# 监听端口
PORT=8787

# 同一阶段内并行的角色数（1-8）
CONCURRENCY=4

# 单次模型调用超时（毫秒）
REQUEST_TIMEOUT_MS=120000

# 强制离线演示模式：=1 时全部走 Mock 端口，并允许使用合成行情
OFFLINE_DEMO=0